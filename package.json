{
  "name": "dsh-worktree",
  "version": "0.1.0",
  "private": true,
  "description": "Task-oriented Git worktree management for DSH.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpacachen/dsh-worktree.git"
  },
  "homepage": "https://github.com/alpacachen/dsh-worktree",
  "bugs": {
    "url": "https://github.com/alpacachen/dsh-worktree/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:tracked-bundle": "node scripts/check-tracked-bundle.mjs",
    "check:package": "node scripts/check-package-contents.mjs",
    "test": "pnpm build && pnpm typecheck && pnpm test:unit && pnpm check:client-bundle && pnpm check:tracked-bundle && pnpm check:package"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "lucide-react": "0.474.0"
  }
}
